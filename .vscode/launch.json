      "args": [
        "--game",
        "${input:captureGame}",
        "--level",
        "${input:captureLevel}"
      ]
    }
  ],
  "inputs": [
    {
      "id": "captureGame",
      "type": "pickString",
      "description": "Capture game",
      "default": "snake",
      "options": [
        "snake",
        "bang",
        "tower",
        "vroom",
        "frogger",
        "cardz",
        "osero",
        "kick"
      ]
    },
    {
      "id": "captureLevel",
      "type": "pickString",
      "description": "Capture curriculum level",
      "default": "5",
      "options": [
        "1",
        "2",
        "3",
        "4",
        "5"
      ]
    },
    {
      "id": "playLevel",
      "type": "pickString",
      "description": "Play level",
      "default": "5",
      "options": [
        "1",
        "2",
        "3",
        "4",
        "5"
      ]
    },
    {
      "id": "oseroBoardSize",
      "type": "pickString",
      "description": "Osero board size",
      "default": "6x6",
      "options": [
        "4x4",
        "6x6",
        "8x8"
      ]
    },
    {
      "id": "trainResumeMode",
      "type": "pickString",
      "description": "Train start mode",
      "default": "New",
      "options": [
        "New",
        "Best"
      ]
    },
    {
      "id": "trainResumeLevel",
      "type": "pickString",
      "description": "Resume level (used for Best)",
      "default": "1",
      "options": [
        "1",
        "2",
        "3",
        "4",
        "5"
      ]
    }
  ]
}

