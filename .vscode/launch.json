{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run - Train",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/../GameEnv/Scripts/python.exe",
      "module": "scripts.train",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--game",
        "${input:gameLevel3}",
        "--algo",
        "${input:algoLevel3}",
        "--level",
        "${input:level3}",
        "--resume",
        "${input:resumeMode}"
      ]
    },
    {
      "name": "Run - Play User",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/../GameEnv/Scripts/python.exe",
      "module": "scripts.play_user",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--game",
        "${input:gameLevel3}",
        "--level",
        "${input:level3}"
      ]
    },
    {
      "name": "Run - Play AI",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/../GameEnv/Scripts/python.exe",
      "module": "scripts.play_ai",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--game",
        "${input:gameLevel3}",
        "--algo",
        "${input:algoLevel3}",
        "--level",
        "${input:level3}",
        "--render"
      ]
    },
    {
      "name": "Run - Capture Demo",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/../GameEnv/Scripts/python.exe",
      "module": "scripts.capture_demo_ai",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--game",
        "${input:gameLevel3}",
        "--algo",
        "${input:algoLevel3}",
        "--level",
        "${input:level3}"
      ]
    }
  ],
  "inputs": [
    {
      "id": "gameLevel3",
      "type": "pickString",
      "description": "Active game using the shared launch flow",
      "default": "bang",
      "options": [
        "snake",
        "bang",
        "jump",
        "vroom",
        "osero",
        "kick"
      ]
    },
    {
      "id": "algoLevel3",
      "type": "pickString",
      "description": "Algorithm override for the selected game (use auto for the game's default)",
      "default": "auto",
      "options": [
        "auto",
        "qlearn",
        "dqn",
        "sac",
        "ppo",
        "a2c",
        "recurrent_ppo",
        "mappo",
        "search_play"
      ]
    },
    {
      "id": "level3",
      "type": "pickString",
      "description": "Shared difficulty level (maps per game)",
      "default": "3",
      "options": [
        "1",
        "2",
        "3"
      ]
    },
    {
      "id": "resumeMode",
      "type": "pickString",
      "description": "Training resume source",
      "default": "none",
      "options": [
        "none",
        "best",
        "check",
        "auto"
      ]
    }
  ]
}
