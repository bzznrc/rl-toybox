{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run - Train",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/../GameEnv/Scripts/python.exe",
      "module": "scripts.train",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--game",
        "${input:curriculumGame}",
        "--algo",
        "${input:curriculumAlgo}",
        "--level",
        "${input:curriculumTrainLevel}",
        "--resume",
        "${input:resumeMode}"
      ]
    },
    {
      "name": "Run - Play User",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/../GameEnv/Scripts/python.exe",
      "module": "scripts.play_user",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--game",
        "${input:curriculumGame}",
        "--level",
        "${input:curriculumPlayLevel}"
      ]
    },
    {
      "name": "Run - Play AI",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/../GameEnv/Scripts/python.exe",
      "module": "scripts.play_ai",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--game",
        "${input:curriculumGame}",
        "--algo",
        "${input:curriculumAlgo}",
        "--level",
        "${input:curriculumPlayLevel}",
        "--render"
      ]
    },
    {
      "name": "Run - Capture Demo",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/../GameEnv/Scripts/python.exe",
      "module": "scripts.capture_demo_ai",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--game",
        "${input:curriculumGame}",
        "--algo",
        "${input:curriculumAlgo}",
        "--level",
        "${input:curriculumPlayLevel}"
      ]
    },
    {
      "name": "Run - Train (Osero)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/../GameEnv/Scripts/python.exe",
      "module": "scripts.train",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "OSERO_BOARD_SIZE": "${input:oseroBoardSize}"
      },
      "args": [
        "--game",
        "osero",
        "--algo",
        "${input:oseroAlgo}",
        "--resume",
        "${input:resumeMode}"
      ]
    },
    {
      "name": "Run - Play User (Osero)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/../GameEnv/Scripts/python.exe",
      "module": "scripts.play_user",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "OSERO_BOARD_SIZE": "${input:oseroBoardSize}"
      },
      "args": [
        "--game",
        "osero"
      ]
    },
    {
      "name": "Run - Play AI (Osero)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/../GameEnv/Scripts/python.exe",
      "module": "scripts.play_ai",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "OSERO_BOARD_SIZE": "${input:oseroBoardSize}"
      },
      "args": [
        "--game",
        "osero",
        "--algo",
        "${input:oseroAlgo}",
        "--render"
      ]
    },
    {
      "name": "Run - Capture Demo (Osero)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/../GameEnv/Scripts/python.exe",
      "module": "scripts.capture_demo_ai",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "OSERO_BOARD_SIZE": "${input:oseroBoardSize}"
      },
      "args": [
        "--game",
        "osero",
        "--algo",
        "${input:oseroAlgo}"
      ]
    }
  ],
  "inputs": [
    {
      "id": "curriculumGame",
      "type": "pickString",
      "description": "Curriculum-based game using the shared L1-L5 launch flow",
      "default": "bang",
      "options": [
        "snake",
        "bang",
        "jump",
        "vroom",
        "kick"
      ]
    },
    {
      "id": "curriculumAlgo",
      "type": "pickString",
      "description": "Algorithm override for the selected curriculum game (use auto for the game's default)",
      "default": "auto",
      "options": [
        "auto",
        "qlearn",
        "dqn",
        "sac",
        "ppo",
        "a2c",
        "recurrent_ppo",
        "mappo",
        "search_play"
      ]
    },
    {
      "id": "curriculumTrainLevel",
      "type": "pickString",
      "description": "Training start level for curriculum games",
      "default": "1",
      "options": [
        "1",
        "2",
        "3",
        "4",
        "5"
      ]
    },
    {
      "id": "curriculumPlayLevel",
      "type": "pickString",
      "description": "Play / eval / capture level for curriculum games",
      "default": "5",
      "options": [
        "1",
        "2",
        "3",
        "4",
        "5"
      ]
    },
    {
      "id": "oseroAlgo",
      "type": "pickString",
      "description": "Algorithm override for Osero",
      "default": "auto",
      "options": [
        "auto",
        "search_play"
      ]
    },
    {
      "id": "oseroBoardSize",
      "type": "pickString",
      "description": "Osero board size",
      "default": "6x6",
      "options": [
        "4x4",
        "6x6",
        "8x8"
      ]
    },
    {
      "id": "resumeMode",
      "type": "pickString",
      "description": "Training resume source",
      "default": "none",
      "options": [
        "none",
        "best",
        "check",
        "auto"
      ]
    }
  ]
}
